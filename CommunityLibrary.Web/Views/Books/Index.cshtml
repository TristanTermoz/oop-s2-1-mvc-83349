@model CommunityLibrary.Web.ViewModels.BookSearchViewModel

<h2>Books</h2>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="searchTerm" value="@Model.SearchTerm"
               placeholder="Search title or author..." class="form-control" />
    </div>
    <div class="col-md-3">
        <select name="category" class="form-select">
            <option value="">All Categories</option>
            @foreach (var cat in Model.Categories)
            {
                <option value="@cat" selected="@(Model.Category == cat)">
                    @cat
                </option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="availability" class="form-select">
            <option value="">All</option>
            <option value="Available" selected="@(Model.Availability == "Available")">Available</option>
            <option value="OnLoan" selected="@(Model.Availability == "OnLoan")">On Loan</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Search</button>
    </div>
</form>
<div class="mb-3 d-flex justify-content-between">
    <div>
        <a asp-action="Create" class="btn btn-primary btn-sm">Create New Book</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-2">Clear filters</a>
    </div>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Category</th>
            <th>Available</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model.Books)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Category</td>
                <td>@(book.IsAvailable ? "Yes" : "On Loan")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-secondary me-1">Edit</a>
                    <form asp-action="Delete" asp-route-id="@book.Id" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete book?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>